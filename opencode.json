{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "compaction": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    }
  },
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "default_agent": "build",
  "formatter": {
    "dartfmt": {
      "command": ["dart", "format", "$FILE"],
      "extensions": [".dart"]
    },
    "eslint": {
      "command": ["npx", "eslint", "--fix", "$FILE"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".json", ".md", ".yml", ".yaml", ".css", ".scss"]
    },
    "rubocop": {
      "command": ["bundle", "exec", "rubocop", "-a", "$FILE"],
      "extensions": [".rb", ".rake", ".gemspec", ".ru"]
    }
  },
  "instructions": ["plugin/shell-strategy/shell_strategy.md"],
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "gamelab-mcp": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.gamelabstudio.co/sse",
      "headers": {
        "X-API-Key": "{env:GAMELAB_API_KEY}"
      }
    },
    "kravos": {
      "enabled": true,
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.kravos.ai/api/v1"
    },
    "coolify": {
      "type": "local",
      "command": ["npx", "-y", "@masonator/coolify-mcp"],
      "enabled": true,
      "environment": {
        "COOLIFY_BASE_URL": "{env:COOLIFY_BASE_URL}",
        "COOLIFY_ACCESS_TOKEN": "{env:COOLIFY_ACCESS_TOKEN}"
      }
    },
    "mobbin": {
      "enabled": true,
      "type": "remote",
      "url": "https://api.mobbin.com/mcp"
    },
    "playwright": {
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--caps=core,vision,pdf,testing",
        "--output-dir=./browser-outputs",
        "--viewport-size=1920x1080",
        "--timeout-action=10000"
      ],
      "enabled": false,
      "type": "local"
    },
    "blender-mcp": {
      "command": ["/Users/mm/.local/bin/uvx", "blender-mcp"],
      "enabled": true,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876"
      },
      "type": "local"
    },
    "sentry": {
      "enabled": false,
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    }
  },
  "model": "openai/gpt-6-astra",
  "permission": {
    "bash": {
      "*": "allow",
      "chmod *": "ask",
      "chown *": "ask",
      "curl *": "ask",
      "dd *": "ask",
      "git clean *": "ask",
      "git commit --amend*": "ask",
      "git push *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "mv *": "ask",
      "rm *": "ask",
      "sudo *": "ask",
      "wget *": "ask"
    },
    "doom_loop": "ask",
    "edit": {
      "*": "allow",
      "**/.aws/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.env.example": "allow",
      "**/.ssh/**": "deny",
      "**/secrets/**": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/Users/mm/.config/opencode": "allow",
      "/Users/mm/.config/opencode/**": "allow",
      "/Users/mm/.claude/skills": "allow",
      "/Users/mm/.claude/skills/**": "allow",
      "/Users/mm/.agents": "allow",
      "/Users/mm/.agents/**": "allow",
      "/Users/mm/Pictures/Screenshots": "allow",
      "/Users/mm/Pictures/Screenshots/*": "allow"
    },
    "read": {
      "*": "allow",
      "**/.aws/**": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/.ssh/**": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny"
    },
    "skill": {
      "*": "allow",
      "code-audit": "deny"
    },
    "task": {
      "*": "deny"
    }
  },
  "plugin": [
    "opencode-dynamic-context-pruning",
    "@simonwjackson/opencode-direnv",
    "btw-opencode",
    "@nick-vi/opencode-type-inject",
    "opencode-mem",
    [
      "@plannotator/opencode@0.27.4",
      {
        "workflow": "manual"
      }
    ],
    "opencode-zellij-namer@1.1.3",
    "@slkiser/opencode-quota@4.8.2",
    "opencode-websearch-cited@1.2.0"
  ],
  "share": "manual",
  "shell": "zsh",
  "subagent_depth": 1,
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.next/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/node_modules/**",
      "**/vendor/**",
      "**/.turbo/**",
      "**/.pytest_cache/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/target/**",
      "**/.dart_tool/**",
      "**/ios/Pods/**",
      "**/ios/build/**",
      "**/ios/DerivedData/**",
      "**/android/.gradle/**",
      "**/android/build/**",
      "**/android/app/build/**"
    ]
  },
  "provider": {
    "copilot": {},
    "openai": {},
    "openrouter": {},
    "zai": {},
    "deepseek": {
      "models": {
        "deepseek-v4.1-flash-expires-on-0910": {
          "name": "DeepSeek V4.1 Flash (Beta, expires Sep 10)",
          "family": "deepseek-flash",
          "status": "beta",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cache_read": 0.0028
          },
          "limit": {
            "context": 258000,
            "output": 384000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "opencode-go": {},
    "ollama-cloud": {}
  }
}
