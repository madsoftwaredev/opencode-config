{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "default_agent": "orchestrator",
  "formatter": {
    "dartfmt": {
      "command": ["dart", "format", "$FILE"],
      "extensions": [".dart"]
    },
    "eslint": {
      "command": ["npx", "eslint", "--fix", "$FILE"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "gofmt": {
      "command": ["gofmt", "-w", "$FILE"],
      "extensions": [".go"]
    },
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".json", ".md", ".yml", ".yaml", ".css", ".scss"]
    },
    "rubocop": {
      "command": ["bundle", "exec", "rubocop", "-a", "$FILE"],
      "extensions": [".rb", ".rake", ".gemspec", ".ru"]
    },
    "ruff": {
      "command": ["bash", "-lc", "ruff check --fix \"$FILE\" && ruff format \"$FILE\""],
      "extensions": [".py", ".pyi"]
    },
    "rustfmt": {
      "command": ["rustfmt", "$FILE"],
      "extensions": [".rs"]
    }
  },
  "instructions": [
    "instructions/core.md",
    "instructions/documentation.md",
    "instructions/testing.md",
    "instructions/security.md",
    "instructions/git.md",
    "instructions/api.md",
    "instructions/database.md",
    "plugin/shell-strategy/shell_strategy.md"
  ],
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "playwright": {
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--caps=core,vision,pdf,testing",
        "--output-dir=./browser-outputs",
        "--viewport-size=1920x1080",
        "--timeout-action=10000"
      ],
      "enabled": true,
      "type": "local"
    },
    "sentry": {
      "enabled": false,
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    }
  },
  "model": "ollama/minimax-m2.7:cloud",
  "permission": {
    "bash": {
      "*": "allow",
      "chmod *": "ask",
      "chown *": "ask",
      "curl *": "ask",
      "dd *": "ask",
      "git clean *": "ask",
      "git commit --amend*": "ask",
      "git push *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "mv *": "ask",
      "rm *": "ask",
      "sudo *": "ask",
      "wget *": "ask"
    },
    "doom_loop": "ask",
    "edit": {
      "*": "allow",
      "**/.aws/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/secrets/**": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/Users/mm/.config/opencode": "allow",
      "/Users/mm/.config/opencode/**": "allow",
      "/Users/mm/.claude/skills": "allow",
      "/Users/mm/.claude/skills/**": "allow",
      "/Users/mm/.agents": "allow",
      "/Users/mm/.agents/**": "allow",
      "/Users/mm/Pictures/Screenshots": "allow",
      "/Users/mm/Pictures/Screenshots/*": "allow"
    },
    "read": {
      "*": "allow",
      "**/*credential*": "deny",
      "**/*credentials*": "deny",
      "**/*private_key*": "deny",
      "**/*token*": "deny",
      "**/.aws/**": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/.ssh/**": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny"
    },
    "skill": {
      "*": "allow"
    },
    "task": {
      "*": "deny"
    }
  },
  "plugin": [
    "@ex-machina/opencode-anthropic-auth",
    "opencode-dynamic-context-pruning",
    "@nick-vi/opencode-type-inject",
    "opencode-mem"
  ],
  "share": "manual",
  "shell": "zsh",
  "subagent_depth": 1,
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.next/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/node_modules/**",
      "**/vendor/**",
      "**/.turbo/**",
      "**/.pytest_cache/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/target/**",
      "**/.dart_tool/**",
      "**/ios/Pods/**",
      "**/ios/build/**",
      "**/ios/DerivedData/**",
      "**/android/.gradle/**",
      "**/android/build/**",
      "**/android/app/build/**"
    ]
  }
}
