{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "description": "Default primary coding agent. Works directly and spawns its own short-lived subagents, which inherit this agent's model. The named tiered workers are denied; use the tier orchestrators when you need a specific model family",
      "model": "openai/gpt-6.1-sol#high",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    }
  },
  "update": "auto",
  "compaction": {
    "auto": true
  },
  "default_agent": "build",
  "formatter": {
    "rubocop": {
      "command": ["bundle", "exec", "rubocop", "-a", "$FILE"],
      "extensions": [".rb", ".rake", ".gemspec", ".ru"]
    }
  },
  "instructions": ["plugin/shell-strategy/shell_strategy.md"],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "gamelab-mcp": {
        "type": "remote",
        "url": "https://mcp.gamelabstudio.co/mcp",
        "headers": {
          "X-API-Key": "{env:GAMELAB_API_KEY}"
        }
      },
      "kravos": {
        "oauth": {},
        "type": "remote",
        "url": "https://mcp.kravos.ai/api/v1"
      },
      "coolify": {
        "type": "local",
        "command": ["npx", "-y", "@masonator/coolify-mcp"],
        "environment": {
          "COOLIFY_BASE_URL": "{env:COOLIFY_BASE_URL}",
          "COOLIFY_ACCESS_TOKEN": "{env:COOLIFY_ACCESS_TOKEN}"
        }
      },
      "mobbin": {
        "type": "remote",
        "url": "https://api.mobbin.com/mcp"
      },
      "playwright": {
        "command": [
          "npx",
          "@playwright/mcp@latest",
          "--browser=chromium",
          "--caps=core,vision,pdf,testing",
          "--output-dir=./browser-outputs",
          "--viewport-size=1920x1080",
          "--timeout-action=10000"
        ],
        "disabled": true,
        "type": "local"
      },
      "tripo": {
        "type": "local",
        "timeout": { "startup": 30000, "catalog": 30000, "execution": 1800000 },
        "command": [
          "/Users/mm/.nvm/versions/node/v26.9.0/bin/node",
          "/Users/mm/.nvm/versions/node/v26.9.0/lib/node_modules/tripo-cli/dist/cli.js",
          "mcp"
        ]
      },
      "blender-mcp": {
        "command": ["/Users/mm/.local/bin/blender-mcp"],
        "environment": {
          "BLENDER_PATH": "/Applications/Blender.app/Contents/MacOS/Blender"
        },
        "type": "local"
      },
      "sentry": {
        "oauth": {},
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "disabled": true
      },
      "elevenlabs": {
        "type": "remote",
        "url": "https://api.us.elevenlabs.io/v1/mcp"
      },
      "elevenlabs-audio": {
        "type": "local",
        "command": [
          "/bin/zsh",
          "-c",
          "if [[ -z ${ELEVENLABS_API_KEY:-} ]]; then source \"$HOME/.zshrc\" >&2 || exit; fi; exec node \"$1\"",
          "elevenlabs-audio",
          "/Users/mm/.config/opencode/mcp/elevenlabs-audio/server.mjs"
        ],
        "environment": {
          "ELEVENLABS_API_KEY": "{env:ELEVENLABS_API_KEY}"
        }
      }
    }
  },
  "model": "openai/gpt-6.1-sol",
  "plugins": [
    {
      "package": "./plugins/compaction-model",
      "options": {
        "model": "opencode-go/deepseek-v4.1-flash#max"
      }
    },
    "@openchamber/opencode-claude"
  ],
  "permissions": [
    { "action": "tripo_tripo_make", "resource": "*", "effect": "ask" },
    { "action": "elevenlabs-audio_generate_*", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "chown *", "effect": "ask" },
    { "action": "shell", "resource": "curl *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git commit --amend*", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "wget *", "effect": "ask" },
    { "action": "doom_loop", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "**/.aws/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.env", "effect": "deny" },
    { "action": "edit", "resource": "**/.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "edit", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/Users/mm/.config/opencode", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "/Users/mm/.config/opencode/**",
      "effect": "allow"
    },
    { "action": "external_directory", "resource": "/Users/mm/.claude/skills", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "/Users/mm/.claude/skills/**",
      "effect": "allow"
    },
    { "action": "external_directory", "resource": "/Users/mm/.agents", "effect": "allow" },
    { "action": "external_directory", "resource": "/Users/mm/.agents/**", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "/Users/mm/Pictures/Screenshots",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/Users/mm/Pictures/Screenshots/*",
      "effect": "allow"
    },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "**/.aws/**", "effect": "deny" },
    { "action": "read", "resource": "**/.netrc", "effect": "deny" },
    { "action": "read", "resource": "**/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "**/.pypirc", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "**/secrets/**", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "code-audit", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" }
  ],
  "share": "manual",
  "shell": "zsh",
  "experimental": {
    "subagent_depth": 1,
    "policies": [
      { "action": "permission", "resource": "elevenlabs_creative_generate_image:*", "effect": "deny" },
      { "action": "permission", "resource": "elevenlabs_creative_edit_image:*", "effect": "deny" },
      // Generic flow runners can execute image nodes; direct audio/video tools remain available.
      { "action": "permission", "resource": "elevenlabs_creative_generate_in_flow:*", "effect": "deny" },
      { "action": "permission", "resource": "elevenlabs_creative_run_flow_nodes:*", "effect": "deny" }
    ]
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.next/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/node_modules/**",
      "**/vendor/**",
      "**/.turbo/**",
      "**/.pytest_cache/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/target/**",
      "**/.dart_tool/**",
      "**/ios/Pods/**",
      "**/ios/build/**",
      "**/ios/DerivedData/**",
      "**/android/.gradle/**",
      "**/android/build/**",
      "**/android/app/build/**"
    ]
  },
  "providers": {
    "copilot": {},
    "openai": {
      "models": {
        "gpt-5.4": {
