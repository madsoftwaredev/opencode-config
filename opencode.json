          }
        }
      }
    },
    "openrouter": {
      "models": {
        "xiaomi/mimo-v2.6-flash": {
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "limit": {
            "context": 384000,
            "input": 256000,
            "output": 128000
          }
        },
        "xiaomi/mimo-v2.6-pro": {
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "limit": {
            "context": 384000,
            "input": 256000,
            "output": 128000
          }
        },
        "xiaomi/mimo-v2.6-pro-ultraspeed": {
          "limit": {
            "context": 384000,
            "input": 256000,
            "output": 128000
          }
        }
      }
    },
    "zai": {},
    "deepseek": {
      "models": {
        "deepseek-flash": {
          "limit": {
            "context": 258000,
            "output": 384000
          }
        }
      }
    },
    "opencode": {
      "models": {
        "mimo-v2.6-flash-free": {
          "limit": {
