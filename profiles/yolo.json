{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "yolo-orchestrator": { "permission": { "question": "allow" } },
    "yolo-eco-orchestrator": { "permission": { "question": "allow" } },
    "yolo-flash-orchestrator": { "permission": { "question": "allow" } },
    "yolo-eco-fast-orchestrator": { "permission": { "question": "allow" } }
  },
  "permission": {
    "external_directory": "ask",
    "question": "deny",
    "doom_loop": "allow",
    "bash": {
      "sudo*": "ask",
      "git push*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh pr close*": "ask",
      "gh pr edit*": "ask",
      "gh pr comment*": "ask",
      "gh pr review*": "ask",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh issue reopen*": "ask",
      "gh issue comment*": "ask",
      "gh release create*": "ask",
      "gh release delete*": "ask",
      "gh release edit*": "ask",
      "gh release upload*": "ask",
      "gh repo create*": "ask",
      "gh repo delete*": "ask",
      "gh repo archive*": "ask",
      "gh repo rename*": "ask",
      "gh repo fork*": "ask",
      "gh workflow run*": "ask",
      "gh run cancel*": "ask",
      "gh run rerun*": "ask",
      "gh run delete*": "ask",
      "gh secret *": "ask",
      "gh variable *": "ask",
      "gh auth login*": "ask",
      "gh auth logout*": "ask",
      "gh auth refresh*": "ask",
      "gh auth setup-git*": "ask",
      "gh auth switch*": "ask",
      "gh auth status*": "ask",
      "gh auth token*": "deny",
      "gh auth status*--show-token*": "deny",
      "gh auth status -t*": "deny",
      "gh auth status * -t*": "deny",
      "gh api -X POST*": "ask",
      "gh api -X PUT*": "ask",
      "gh api -X PATCH*": "ask",
      "gh api -X DELETE*": "ask",
      "gh api --method POST*": "ask",
      "gh api --method PUT*": "ask",
      "gh api --method PATCH*": "ask",
      "gh api --method DELETE*": "ask",
      "gh api * -X POST*": "ask",
      "gh api * -X PUT*": "ask",
      "gh api * -X PATCH*": "ask",
      "gh api * -X DELETE*": "ask",
      "gh api * --method POST*": "ask",
      "gh api * --method PUT*": "ask",
      "gh api * --method PATCH*": "ask",
      "gh api * --method DELETE*": "ask",
      "gh api * -f *": "ask",
      "gh api * -F *": "ask",
      "gh api * --field *": "ask",
      "gh api * --raw-field *": "ask",
      "gh api * --input *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "sftp *": "ask",
      "rsync *": "ask",
      "kubectl *": "ask",
      "helm *": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "tofu apply*": "ask",
      "tofu destroy*": "ask",
      "aws *": "ask",
      "gcloud *": "ask",
      "az *": "ask",
      "vercel *": "ask",
      "netlify *": "ask",
      "fly *": "ask",
      "railway *": "ask",
      "npm publish*": "ask",
      "pnpm publish*": "ask",
      "yarn npm publish*": "ask",
      "bun publish*": "ask",
      "cargo publish*": "ask",
      "gem push*": "ask",
      "twine upload*": "ask",
      "brew *": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "launchctl *": "ask",
      "systemctl *": "ask"
    }
