{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "agent": {
    "implementation-engineer": { "model": "openai/gpt-6-sol-fast" },
    "repository-analyst": { "model": "openai/gpt-6-sol-fast" },
    "bounded-worker": { "model": "openai/gpt-6-luna-fast" },
    "economy-implementation-engineer": { "model": "openai/gpt-6-luna-fast" },
    "economy-bounded-worker": { "model": "openai/gpt-6-luna-fast" },
    "economy-repository-analyst": { "model": "openai/gpt-6-luna-fast" },
    "economy-pr-reviewer": { "model": "openai/gpt-6-luna-fast" },
    "pr-reviewer": { "model": "openai/gpt-6-sol-fast" },
    "exceptional-pr-reviewer": { "model": "openai/gpt-6-astra-fast" },
    "pr-review-adjudicator": { "model": "openai/gpt-6-astra-fast" },
    "principal-engineer": { "model": "openai/gpt-6-astra-fast" },
    "ui-ux-analyst": { "model": "openai/gpt-6-astra-fast" }
  }
}
