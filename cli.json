{
  "theme": {
    "name": "palenight",
    "mode": "system"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word",
    "view": "unified",
    "single": true,
    "tree": false
  },
  "terminal": {
    "title": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "new_location": "launch",
    "image_preview": true,
    "tps": true,
    "grouping": "auto",
    "verbosity": "low",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "layout": "vertical",
    "scope": "cwd",
    "mode": "auto"
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact",
    "editor": false
  },
  "leader": {
    "timeout": 3000
  },
  "mouse": true,
  "attention": {
    "notifications": true,
    "sound": false
  },
  "plugins": [
    {
      "package": "./opencode-stats",
      "options": {
        "speed": true,
        "turns": true,
        "steps": true
      }
    },
    {
      "package": "./opencode-usage",
      "options": {
        "sidebar": true,
        "includeSubagents": true
      }
    },
    "-btw",
    {
      "package": "/Users/mm/Development/madsoftwaredev/opencode-plugins/packages/compaction-fold",
      "options": {
        "defaultExpanded": false
      }
    }
  ]
}
