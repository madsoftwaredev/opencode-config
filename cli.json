{
  "theme": {
    "name": "aura",
    "mode": "system"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word",
    "view": "unified",
    "single": true
  },
  "terminal": {
    "title": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "new_location": "launch"
  },
  "animations": true,
  "tabs": {
    "layout": "vertical",
    "scope": "cwd"
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "leader": {
    "timeout": 3000
  },
  "mouse": true,
  "attention": {
    "notifications": true,
    "sound": false
  }
}
